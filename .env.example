# LLM endpoint (OpenAI-compatible). Copy to .env and adjust.
DATAMATE_BASE_URL=http://localhost:4308/v1
DATAMATE_API_KEY=dummy
DATAMATE_MODEL=default

# Sampling. Low temperature: the task wants one deterministic computation.
DATAMATE_TEMPERATURE=0.0
DATAMATE_MAX_TOKENS=4096

# How many times a crashing snippet is sent back to the model with its traceback.
DATAMATE_MAX_REPAIRS=2
# Seconds a generated snippet may run before it is killed (then: abstain).
DATAMATE_EXEC_TIMEOUT=180

# Raw rows shown per table in the prompt. More rows = better header guesses,
# longer prompt.
DATAMATE_PREVIEW_ROWS=6
